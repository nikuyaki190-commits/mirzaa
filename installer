#!/data/data/com.termux/files/usr/bin/bash
set -o pipefail

DOWNLOAD_DIR="/sdcard/Download"
WEB_DIR="$HOME/web_apk"
LOG_FILE="$HOME/install_log.txt"

mkdir -p "$WEB_DIR"

show_banner() {
    clear
    echo -e "\e[1;36m"
    echo "================================"
    echo "      M I R Z A A"
    echo "      I N S T A L L E R"
    echo "================================"
    echo -e "\e[0m"
}

check_root() {
    if ! su -c "echo ok" >/dev/null 2>&1; then
        echo -e "\e[1;31mAkses root tidak tersedia / ditolak. Cek Magisk/SU manager.\e[0m"
        exit 1
    fi
}

get_size_mb() {
    local file="$1"
    if [ -f "$file" ]; then
        local bytes
        bytes=$(stat -c%s "$file" 2>/dev/null || echo 0)
        awk -v b="$bytes" 'BEGIN { printf "%.2f MB", b/1024/1024 }'
    else
        echo "0 MB"
    fi
}

parse_selection() {
    local choice="$1"
    local max="$2"
    local -n result=$3
    result=()

    choice=$(echo "$choice" | tr -d '[:space:]')
    [ -z "$choice" ] && return

    if [ "$choice" == "all" ]; then
        for ((i=0; i<max; i++)); do result+=($i); done
        return
    fi

    if [[ "$choice" =~ ^[0-9]+-[0-9]+$ ]]; then
        local start=$(echo "$choice" | cut -d'-' -f1)
        local end=$(echo "$choice" | cut -d'-' -f2)
        if [ "$start" -gt "$end" ]; then
            local tmp=$start; start=$end; end=$tmp
        fi
        for ((i=start; i<=end; i++)); do
            idx=$((i-1))
            [ $idx -ge 0 ] && [ $idx -lt $max ] && result+=($idx)
        done
        return
    fi

    if [[ "$choice" =~ ^[0-9,]+$ ]]; then
        IFS=',' read -ra nums <<< "$choice"
        for n in "${nums[@]}"; do
            [ -z "$n" ] && continue
            idx=$((n-1))
            [ $idx -ge 0 ] && [ $idx -lt $max ] && result+=($idx)
        done
        return
    fi

    echo -e "\e[1;31mFormat pilihan tidak dikenali: '$choice'\e[0m"
}

install_selected() {
    local -n list=$1
    local -n indices=$2
    local delete_after=$3

    if [ ${#indices[@]} -eq 0 ]; then
        echo "Tidak ada APK yang dipilih."
        return
    fi

    echo ""
    echo "=== Mulai Install - $(date) ===" | tee -a "$LOG_FILE"
    echo ""

    local ok=0 fail=0

    for idx in "${indices[@]}"; do
        apk="${list[$idx]}"

        if [ ! -f "$apk" ]; then
            echo -e "\e[1;31m✘ File tidak ditemukan: $apk\e[0m" | tee -a "$LOG_FILE"
            fail=$((fail+1))
            continue
        fi

        NAME=$(basename "$apk")
        SIZE=$(get_size_mb "$apk")
        echo -e "\e[1;33m>> Menginstall: $NAME [$SIZE]\e[0m" | tee -a "$LOG_FILE"

        RESULT=$(su -c "pm install -r '$apk'" 2>&1)
        echo "$RESULT" | tee -a "$LOG_FILE"

        if echo "$RESULT" | grep -qi "Success"; then
            echo -e "\e[1;32m✔ Berhasil: $NAME\e[0m" | tee -a "$LOG_FILE"
            ok=$((ok+1))
            if [ "$delete_after" == "yes" ]; then
                rm -f "$apk"
                echo -e "\e[1;34m🗑 Dihapus dari sumber: $NAME\e[0m" | tee -a "$LOG_FILE"
            fi
        else
            echo -e "\e[1;31m✘ Gagal: $NAME\e[0m" | tee -a "$LOG_FILE"
            fail=$((fail+1))
        fi
        echo "----------------------------" | tee -a "$LOG_FILE"
    done

    echo ""
    echo -e "Selesai. Berhasil: \e[1;32m$ok\e[0m | Gagal: \e[1;31m$fail\e[0m"
    echo "Log tersimpan di $LOG_FILE"
}

do_install() {
    if [ ! -d "$DOWNLOAD_DIR" ]; then
        echo "Folder Download tidak ditemukan. Jalankan 'termux-setup-storage' dulu."
        return
    fi

    mapfile -t APK_LIST < <(find "$DOWNLOAD_DIR" -maxdepth 1 -iname "*.apk" 2>/dev/null | sort)

    if [ ${#APK_LIST[@]} -eq 0 ]; then
        echo "Tidak ada file APK di $DOWNLOAD_DIR"
        return
    fi

    echo "Daftar APK ditemukan:"
    echo "----------------------------------------"
    for i in "${!APK_LIST[@]}"; do
        SIZE=$(get_size_mb "${APK_LIST[$i]}")
        printf "%2d) %-35s [%s]\n" $((i+1)) "$(basename "${APK_LIST[$i]}")" "$SIZE"
    done
    echo "----------------------------------------"
    echo "Pilih nomor (contoh: 1-${#APK_LIST[@]}, atau 1,3,5, atau 'all')"
    read -p "Pilihan: " CHOICE

    local indices
    parse_selection "$CHOICE" "${#APK_LIST[@]}" indices

    install_selected APK_LIST indices "yes"
}

do_download_install() {
    echo "Pilih metode:"
    echo " a) Paste link APK langsung (bisa lebih dari satu, pisah spasi)"
    echo " b) Paste URL halaman (auto-scan semua link .apk di halaman itu)"
    read -p "Pilihan (a/b): " METHOD

    LINKS=""

    if [ "$METHOD" == "b" ]; then
        read -p "URL halaman: " PAGE_URL

        if [[ ! "$PAGE_URL" =~ ^https?:// ]]; then
            echo "URL tidak valid, harus mulai dengan http:// atau https://"
            return
        fi

        echo "Mengambil daftar file dari halaman..."
        HTML=$(curl -sL --max-time 20 "$PAGE_URL")

        if [ -z "$HTML" ]; then
            echo "Gagal mengambil halaman (kosong/timeout)."
            return
        fi

        mapfile -t FOUND_LINKS < <(echo "$HTML" | grep -oE '(href|src)="[^"]+\.apk"' | sed -E 's/(href|src)="//;s/"$//' | sort -u)

        if [ ${#FOUND_LINKS[@]} -eq 0 ]; then
            echo "Tidak ada link .apk ditemukan di halaman itu."
            echo "(Situs mungkin butuh JavaScript, coba paste link langsung)"
            return
        fi

        local base
        base=$(echo "$PAGE_URL" | grep -oE '^https?://[^/]+')

        for i in "${!FOUND_LINKS[@]}"; do
            link="${FOUND_LINKS[$i]}"
            if [[ "$link" != http* ]]; then
                if [[ "$link" == /* ]]; then
                    FOUND_LINKS[$i]="${base}${link}"
                else
                    FOUND_LINKS[$i]="${PAGE_URL%/}/${link}"
                fi
            fi
        done

        echo "File APK ditemukan di halaman:"
        echo "----------------------------------------"
        for i in "${!FOUND_LINKS[@]}"; do
            printf "%2d) %s\n" $((i+1)) "$(basename "${FOUND_LINKS[$i]}")"
        done
        echo "----------------------------------------"
        echo "Mau download yang mana? (contoh: 1-${#FOUND_LINKS[@]}, atau 1,3, atau 'all')"
        read -p "Pilihan: " CHOICE

        local indices
        parse_selection "$CHOICE" "${#FOUND_LINKS[@]}" indices
        if [ ${#indices[@]} -eq 0 ]; then
            echo "Tidak ada yang dipilih."
            return
        fi

        for idx in "${indices[@]}"; do
            LINKS="$LINKS ${FOUND_LINKS[$idx]}"
        done
    else
        echo "Paste link APK (bisa lebih dari satu, pisahkan pakai spasi):"
        read -p "> " LINKS
    fi

    LINKS=$(echo "$LINKS" | tr -d '\r')
    if [ -z "$(echo "$LINKS" | tr -d '[:space:]')" ]; then
        echo "Tidak ada link untuk diproses."
        return
    fi

    echo ""
    echo "Mengunduh file..."
    echo ""

    WEB_APK_LIST=()
    local i=1
    for url in $LINKS; do
        [[ "$url" =~ ^https?:// ]] || { echo -e "\e[1;31m✘ Link tidak valid, dilewati: $url\e[0m"; continue; }

        fname="dl_$(date +%s)_${i}.apk"
        echo -e "\e[1;33m>> Download: $url\e[0m"

        HTTP_CODE=$(curl -L -o "$WEB_DIR/$fname" -w "%{http_code}" --max-time 60 --silent "$url")

        if [ -s "$WEB_DIR/$fname" ] && [ "$HTTP_CODE" == "200" ]; then
            SIZE=$(get_size_mb "$WEB_DIR/$fname")
            echo -e "\e[1;32m✔ Tersimpan: $fname [$SIZE]\e[0m"
            WEB_APK_LIST+=("$WEB_DIR/$fname")
        else
            echo -e "\e[1;31m✘ Gagal download (HTTP $HTTP_CODE): $url\e[0m"
            rm -f "$WEB_DIR/$fname"
        fi
        i=$((i+1))
    done

    if [ ${#WEB_APK_LIST[@]} -eq 0 ]; then
        echo "Tidak ada APK berhasil diunduh."
        return
    fi

    echo ""
    echo "APK yang berhasil diunduh:"
    echo "----------------------------------------"
    for i in "${!WEB_APK_LIST[@]}"; do
        SIZE=$(get_size_mb "${WEB_APK_LIST[$i]}")
        printf "%2d) %-35s [%s]\n" $((i+1)) "$(basename "${WEB_APK_LIST[$i]}")" "$SIZE"
    done
    echo "----------------------------------------"
    echo "Mau install APK yang mana? (contoh: 1-${#WEB_APK_LIST[@]}, atau 'all')"
    read -p "Pilihan: " CHOICE2

    local indices2
    parse_selection "$CHOICE2" "${#WEB_APK_LIST[@]}" indices2

    install_selected WEB_APK_LIST indices2 "yes"
}

do_uninstall() {
    echo "Mengambil daftar aplikasi terpasang..."
    mapfile -t PKG_LIST < <(su -c "pm list packages -3" 2>/dev/null | sed 's/^package://' | sort)

    if [ ${#PKG_LIST[@]} -eq 0 ]; then
        echo "Tidak ada aplikasi ditemukan (atau akses root gagal)."
        return
    fi

    echo "Daftar aplikasi terpasang:"
    echo "----------------------------------------"
    for i in "${!PKG_LIST[@]}"; do
        printf "%2d) %s\n" $((i+1)) "${PKG_LIST[$i]}"
    done
    echo "----------------------------------------"
    echo "Pilih nomor (contoh: 1-${#PKG_LIST[@]}, atau 1,3,5, atau 'all')"
    read -p "Pilihan: " CHOICE

    local indices
    parse_selection "$CHOICE" "${#PKG_LIST[@]}" indices
    if [ ${#indices[@]} -eq 0 ]; then
        echo "Tidak ada aplikasi yang dipilih."
        return
    fi

    echo ""
    echo "=== Mulai Uninstall - $(date) ===" | tee -a "$LOG_FILE"
    echo ""

    local ok=0 fail=0
    for idx in "${indices[@]}"; do
        pkg="${PKG_LIST[$idx]}"
        echo -e "\e[1;33m>> Menghapus: $pkg\e[0m" | tee -a "$LOG_FILE"

        RESULT=$(su -c "pm uninstall --user 0 '$pkg'" 2>&1)
        echo "$RESULT" | tee -a "$LOG_FILE"

        if echo "$RESULT" | grep -qi "Success"; then
            echo -e "\e[1;32m✔ Terhapus: $pkg\e[0m" | tee -a "$LOG_FILE"
            ok=$((ok+1))
        else
            echo -e "\e[1;31m✘ Gagal hapus: $pkg\e[0m" | tee -a "$LOG_FILE"
            fail=$((fail+1))
        fi
        echo "----------------------------" | tee -a "$LOG_FILE"
    done

    echo ""
    echo -e "Selesai. Berhasil: \e[1;32m$ok\e[0m | Gagal: \e[1;31m$fail\e[0m"
    echo "Log tersimpan di $LOG_FILE"
}

check_root

while true; do
    show_banner
    echo "Pilih menu:"
    echo " 1) Install APK dari folder Download"
    echo " 2) Download & Install APK dari link"
    echo " 3) Uninstall aplikasi terpasang"
    echo " 0) Keluar"
    read -p "Pilihan (0-3): " MENU

    case "$MENU" in
        1) do_install ;;
        2) do_download_install ;;
        3) do_uninstall ;;
        0) echo "Sampai jumpa!"; exit 0 ;;
        *) echo "Pilihan tidak valid." ;;
    esac

    echo ""
    read -p "Tekan ENTER untuk kembali ke menu..." _
done
