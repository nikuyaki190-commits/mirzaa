#!/data/data/com.termux/files/usr/bin/bash

# ============================================================
# MIRZAA APK MANAGER v2
# Termux + Root
# ============================================================

set -o pipefail

DOWNLOAD_DIR="/sdcard/Download"
WEB_DIR="$HOME/web_apk"
LOG_FILE="$HOME/install_log.txt"

# ---------- COLORS ----------
RESET='\e[0m'
BOLD='\e[1m'
RED='\e[1;31m'
GREEN='\e[1;32m'
YELLOW='\e[1;33m'
BLUE='\e[1;34m'
CYAN='\e[1;36m'
MAGENTA='\e[1;35m'
WHITE='\e[1;37m'
GRAY='\e[90m'

mkdir -p "$WEB_DIR"

# ============================================================
# BASIC FUNCTIONS
# ============================================================

pause() {
    echo
    read -rp "Press ENTER to continue..." _
}

sep() {
    local width
    width=$(tput cols 2>/dev/null || echo 40)

    [ "$width" -lt 20 ] && width=20
    [ "$width" -gt 60 ] && width=60

    printf '%*s\n' "$width" '' | tr ' ' '-'
}

clear_screen() {
    clear 2>/dev/null || printf '\033c'
}

banner() {
    clear_screen

    echo -e "${CYAN}${BOLD}"
    echo "╔════════════════════════════════════════╗"
    echo "║          MIRZAA APK MANAGER            ║"
    echo "║                v2.0                    ║"
    echo "╚════════════════════════════════════════╝"
    echo -e "${RESET}"
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

success() {
    echo -e "${GREEN}[✓]${RESET} $*"
    log "[OK] $*"
}

error_msg() {
    echo -e "${RED}[✗]${RESET} $*"
    log "[ERROR] $*"
}

warning() {
    echo -e "${YELLOW}[!]${RESET} $*"
}

info() {
    echo -e "${CYAN}[i]${RESET} $*"
}

# ============================================================
# CHECKS
# ============================================================

check_dependencies() {
    local missing=()

    for cmd in curl find awk sed grep stat basename sort; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done

    if [ ${#missing[@]} -gt 0 ]; then
        error_msg "Dependency belum tersedia:"
        printf '  - %s\n' "${missing[@]}"
        echo
        echo "Install:"
        echo "pkg install curl findutils gawk sed grep coreutils"
        return 1
    fi

    return 0
}

check_root() {
    if ! command -v su >/dev/null 2>&1; then
        error_msg "Perintah su tidak ditemukan."
        return 1
    fi

    if ! su -c 'id' >/dev/null 2>&1; then
        error_msg "Akses root ditolak / tidak tersedia."
        return 1
    fi

    return 0
}

check_storage() {
    if [ ! -d "$DOWNLOAD_DIR" ]; then
        warning "Folder Download belum tersedia."
        echo "Jalankan:"
        echo
        echo "termux-setup-storage"
        echo
        return 1
    fi

    return 0
}

# ============================================================
# UTILITIES
# ============================================================

get_size() {
    local file="$1"

    if [ ! -f "$file" ]; then
        echo "0 B"
        return
    fi

    local bytes
    bytes=$(stat -c%s "$file" 2>/dev/null || echo 0)

    if [ "$bytes" -ge 1073741824 ]; then
        awk -v b="$bytes" 'BEGIN {printf "%.2f GB", b/1073741824}'
    elif [ "$bytes" -ge 1048576 ]; then
        awk -v b="$bytes" 'BEGIN {printf "%.2f MB", b/1048576}'
    elif [ "$bytes" -ge 1024 ]; then
        awk -v b="$bytes" 'BEGIN {printf "%.2f KB", b/1024}'
    else
        echo "${bytes} B"
    fi
}

is_valid_apk() {
    local file="$1"

    [ -f "$file" ] || return 1
    [ -s "$file" ] || return 1

    # APK adalah ZIP archive.
    if command -v unzip >/dev/null 2>&1; then
        unzip -t "$file" >/dev/null 2>&1
        return $?
    fi

    # Fallback jika unzip belum ada.
    if command -v file >/dev/null 2>&1; then
        file "$file" | grep -qiE 'zip|android'
        return $?
    fi

    # Kalau tidak ada validator, minimal cek ukuran.
    [ "$(stat -c%s "$file" 2>/dev/null || echo 0)" -gt 1024 ]
}

package_from_apk() {
    local apk="$1"

    if command -v aapt >/dev/null 2>&1; then
        aapt dump badging "$apk" 2>/dev/null |
            sed -n "s/^package: name='\([^']*\)'.*/\1/p" |
            head -n1
        return
    fi

    echo "-"
}

# ============================================================
# SELECTION PARSER
# ============================================================

parse_selection() {
    local choice="$1"
    local max="$2"
    local -n result=$3

    result=()

    choice=$(echo "$choice" | tr -d '[:space:]')

    [ -z "$choice" ] && return

    if [ "$choice" = "all" ]; then
        for ((i=0; i<max; i++)); do
            result+=("$i")
        done
        return
    fi

    if [[ "$choice" =~ ^[0-9]+-[0-9]+$ ]]; then
        local start="${choice%-*}"
        local end="${choice#*-}"

        if [ "$start" -gt "$end" ]; then
            local tmp="$start"
            start="$end"
            end="$tmp"
        fi

        for ((i=start; i<=end; i++)); do
            local idx=$((i-1))

            if [ "$idx" -ge 0 ] && [ "$idx" -lt "$max" ]; then
                result+=("$idx")
            fi
        done

        return
    fi

    if [[ "$choice" =~ ^[0-9,]+$ ]]; then
        IFS=',' read -ra nums <<< "$choice"

        for n in "${nums[@]}"; do
            [ -z "$n" ] && continue

            local idx=$((n-1))

            if [ "$idx" -ge 0 ] && [ "$idx" -lt "$max" ]; then
                result+=("$idx")
            fi
        done

        return
    fi

    error_msg "Format pilihan tidak dikenali: $choice"
}

# ============================================================
# INSTALL APK
# ============================================================

install_one() {
    local apk="$1"
    local delete_after="$2"

    if [ ! -f "$apk" ]; then
        error_msg "File tidak ditemukan: $(basename "$apk")"
        return 1
    fi

    local name
    name=$(basename "$apk")

    echo
    echo -e "${YELLOW}Installing:${RESET} $name"
    echo -e "${GRAY}Size: $(get_size "$apk")${RESET}"

    if ! is_valid_apk "$apk"; then
        error_msg "File bukan APK/ZIP valid: $name"
        return 1
    fi

    local result
    result=$(su -c "pm install -r --user 0 '$apk'" 2>&1)

    echo "$result"

    if echo "$result" | grep -qi "success"; then
        success "Install berhasil: $name"

        if [ "$delete_after" = "yes" ]; then
            if rm -f "$apk"; then
                info "File sumber dihapus."
            else
                warning "Install berhasil, tetapi gagal menghapus file."
            fi
        fi

        return 0
    fi

    error_msg "Install gagal: $name"
    return 1
}

install_selected() {
    local -n list=$1
    local -n indices=$2
    local delete_after="$3"

    if [ ${#indices[@]} -eq 0 ]; then
        warning "Tidak ada APK yang dipilih."
        return
    fi

    local ok=0
    local fail=0

    echo
    sep
    echo -e "${BOLD}INSTALL START${RESET}"
    sep

    for idx in "${indices[@]}"; do
        if install_one "${list[$idx]}" "$delete_after"; then
            ok=$((ok+1))
        else
            fail=$((fail+1))
        fi

        sep
    done

    echo
    echo -e "${GREEN}SUCCESS: $ok${RESET}"
    echo -e "${RED}FAILED : $fail${RESET}"

    log "Install finished | success=$ok failed=$fail"
}

# ============================================================
# INSTALL FROM DOWNLOAD
# ============================================================

do_install_download() {
    check_storage || return

    while true; do
        mapfile -t APK_LIST < <(
            find "$DOWNLOAD_DIR" \
                -maxdepth 1 \
                -type f \
                -iname "*.apk" \
                2>/dev/null |
            sort
        )

        if [ ${#APK_LIST[@]} -eq 0 ]; then
            warning "Tidak ada APK di:"
            echo "$DOWNLOAD_DIR"
            return
        fi

        echo
        echo -e "${BOLD}APK DI DOWNLOAD${RESET}"
        sep

        for i in "${!APK_LIST[@]}"; do
            local apk="${APK_LIST[$i]}"
            local name
            name=$(basename "$apk")

            echo -e "${WHITE}$((i+1)).${RESET} $name"
            echo -e "    ${GRAY}$(get_size "$apk")${RESET}"
        done

        sep
        echo "Pilih: 1 | 1,3,5 | 1-5 | all"
        echo "Ketik r untuk refresh, q untuk kembali."
        read -rp "> " choice

        case "$choice" in
            q|Q)
                return
                ;;
            r|R)
                continue
                ;;
        esac

        local indices
        parse_selection "$choice" "${#APK_LIST[@]}" indices

        if [ ${#indices[@]} -eq 0 ]; then
            continue
        fi

        install_selected APK_LIST indices "yes"
        pause
    done
}

# ============================================================
# DOWNLOAD APK
# ============================================================

download_one() {
    local url="$1"
    local output="$2"

    echo
    echo -e "${CYAN}URL:${RESET} $url"

    curl \
        -L \
        --fail \
        --show-error \
        --progress-bar \
        --max-time 120 \
        -o "$output" \
        "$url"

    if [ $? -ne 0 ]; then
        rm -f "$output"
        return 1
    fi

    if ! is_valid_apk "$output"; then
        warning "Download selesai tetapi file bukan APK valid."
        rm -f "$output"
        return 1
    fi

    return 0
}

do_download_install() {
    echo
    echo "1) Direct link"
    echo "2) Scan halaman"
    echo "0) Kembali"

    read -rp "> " method

    case "$method" in
        0)
            return
            ;;

        1)
            echo
            echo "Paste link APK."
            echo "Bisa beberapa link, pisahkan dengan spasi."
            read -rp "> " links
            ;;

        2)
            read -rp "URL halaman: " page_url

            if [[ ! "$page_url" =~ ^https?:// ]]; then
                error_msg "URL tidak valid."
                return
            fi

            echo "Mengambil halaman..."

            local html
            html=$(curl \
                -L \
                --fail \
                --silent \
                --show-error \
                --max-time 30 \
                "$page_url")

            if [ -z "$html" ]; then
                error_msg "Gagal mengambil halaman."
                return
            fi

            mapfile -t FOUND_LINKS < <(
                echo "$html" |
                grep -oE 'href=["'\''][^"'\'']+\.apk([^"'\'']*)?["'\'']' |
                sed -E 's/^href=["'\'']//;s/["'\'']$//' |
                sort -u
            )

            if [ ${#FOUND_LINKS[@]} -eq 0 ]; then
                warning "Tidak menemukan link APK."
                return
            fi

            echo
            echo -e "${BOLD}APK DITEMUKAN${RESET}"
            sep

            for i in "${!FOUND_LINKS[@]}"; do
                echo "$((i+1)). ${FOUND_LINKS[$i]}"
            done

            sep
            echo "Pilih: 1 | 1,3 | 1-5 | all"
            read -rp "> " choice

            local indices
            parse_selection "$choice" "${#FOUND_LINKS[@]}" indices

            if [ ${#indices[@]} -eq 0 ]; then
                warning "Tidak ada yang dipilih."
                return
            fi

            links=""

            for idx in "${indices[@]}"; do
                links="$links ${FOUND_LINKS[$idx]}"
            done
            ;;

        *)
            error_msg "Pilihan tidak valid."
            return
            ;;
    esac

    links=$(echo "$links" | tr -d '\r')

    if [ -z "$(echo "$links" | tr -d '[:space:]')" ]; then
        warning "Tidak ada link."
        return
    fi

    local WEB_APK_LIST=()
    local counter=1

    for url in $links; do
        if [[ ! "$url" =~ ^https?:// ]]; then
            warning "URL dilewati: $url"
            continue
        fi

        local output
        output="$WEB_DIR/apk_$(date +%s)_${counter}.apk"

        echo
        echo -e "${BOLD}[$counter] Download${RESET}"

        if download_one "$url" "$output"; then
            success "Download berhasil: $(basename "$output")"
            echo -e "${GRAY}Size: $(get_size "$output")${RESET}"

            WEB_APK_LIST+=("$output")
        else
            error_msg "Download gagal."
        fi

        counter=$((counter+1))
    done

    if [ ${#WEB_APK_LIST[@]} -eq 0 ]; then
        warning "Tidak ada APK yang berhasil di-download."
        return
    fi

    echo
    echo -e "${BOLD}DOWNLOAD SELESAI${RESET}"
    sep

    for i in "${!WEB_APK_LIST[@]}"; do
        echo "$((i+1)). $(basename "${WEB_APK_LIST[$i]}")"
        echo "    $(get_size "${WEB_APK_LIST[$i]}")"
    done

    sep
    echo "Install: 1 | 1,3 | 1-5 | all"
    read -rp "> " choice2

    local indices2
    parse_selection "$choice2" "${#WEB_APK_LIST[@]}" indices2

    install_selected WEB_APK_LIST indices2 "yes"
}

# ============================================================
# LIST INSTALLED APPS
# ============================================================

get_packages() {
    mapfile -t PKG_LIST < <(
        su -c "pm list packages -3" 2>/dev/null |
        sed 's/^package://' |
        sort
    )
}

do_uninstall() {
    get_packages

    if [ ${#PKG_LIST[@]} -eq 0 ]; then
        warning "Tidak ada aplikasi user."
        return
    fi

    echo
    echo -e "${BOLD}USER APPS${RESET}"
    sep

    for i in "${!PKG_LIST[@]}"; do
        echo "$((i+1)). ${PKG_LIST[$i]}"
    done

    sep
    echo "Pilih aplikasi."
    echo "Format: 1 | 1,3 | 1-5 | all"
    read -rp "> " choice

    local indices
    parse_selection "$choice" "${#PKG_LIST[@]}" indices

    if [ ${#indices[@]} -eq 0 ]; then
        return
    fi

    echo
    echo -e "${RED}${BOLD}PERINGATAN${RESET}"
    echo "Aplikasi yang dipilih akan di-uninstall untuk user 0."
    echo

    for idx in "${indices[@]}"; do
        echo " - ${PKG_LIST[$idx]}"
    done

    echo
    read -rp "Lanjutkan? [y/N]: " confirm

    [[ "$confirm" =~ ^[Yy]$ ]] || {
        echo "Dibatalkan."
        return
    }

    local ok=0
    local fail=0

    for idx in "${indices[@]}"; do
        local pkg="${PKG_LIST[$idx]}"

        echo
        echo -e "${YELLOW}> $pkg${RESET}"

        # Stop app sebelum uninstall.
        su -c "am force-stop '$pkg'" >/dev/null 2>&1

        local result
        result=$(su -c "pm uninstall --user 0 '$pkg'" 2>&1)

        echo "$result"

        if echo "$result" | grep -qi "success"; then
            success "Uninstall berhasil: $pkg"
            ok=$((ok+1))
        else
            error_msg "Uninstall gagal: $pkg"
            fail=$((fail+1))
        fi
    done

    echo
    echo -e "${GREEN}SUCCESS: $ok${RESET}"
    echo -e "${RED}FAILED : $fail${RESET}"

    log "Uninstall finished | success=$ok failed=$fail"
}

# ============================================================
# APP INFO
# ============================================================

do_app_info() {
    read -rp "Package name: " pkg

    [ -z "$pkg" ] && return

    echo
    echo -e "${BOLD}PACKAGE INFO${RESET}"
    sep

    su -c "dumpsys package '$pkg'" 2>/dev/null |
        grep -E \
        'versionName=|versionCode=|firstInstallTime=|lastUpdateTime=|codePath=|dataDir=' |
        head -n 20

    echo
    echo "APK path:"
    su -c "pm path '$pkg'" 2>/dev/null
}

# ============================================================
# SEARCH APP
# ============================================================

do_search_app() {
    read -rp "Cari nama/package: " query

    [ -z "$query" ] && return

    get_packages

    echo
    echo -e "${BOLD}HASIL PENCARIAN${RESET}"
    sep

    local found=0

    for pkg in "${PKG_LIST[@]}"; do
        if echo "$pkg" | grep -qi -- "$query"; then
            echo "$pkg"
            found=$((found+1))
        fi
    done

    if [ "$found" -eq 0 ]; then
        warning "Tidak ditemukan."
    else
        echo
        echo "Ditemukan: $found"
    fi
}

# ============================================================
# SYSTEM STATUS
# ============================================================

system_status() {
    echo
    echo -e "${BOLD}SYSTEM STATUS${RESET}"
    sep

    echo -e "Root     : ${GREEN}$(su -c 'id -u' 2>/dev/null || echo 'NO')${RESET}"
    echo "Android  : $(getprop ro.build.version.release 2>/dev/null)"
    echo "SDK      : $(getprop ro.build.version.sdk 2>/dev/null)"
    echo "Device   : $(getprop ro.product.model 2>/dev/null)"
    echo "Storage  : $(df -h /sdcard 2>/dev/null | tail -n1 | awk '{print $4 " free"}')"
    echo "Download : $DOWNLOAD_DIR"
    echo "Web APK  : $WEB_DIR"
    echo "Log      : $LOG_FILE"
}

# ============================================================
# CLEAN WEB APK
# ============================================================

clean_web_apk() {
    local count=0

    shopt -s nullglob

    for file in "$WEB_DIR"/*.apk; do
        rm -f "$file"
        count=$((count+1))
    done

    shopt -u nullglob

    success "Menghapus $count file APK dari web_apk."
}

# ============================================================
# MAIN MENU
# ============================================================

check_dependencies || exit 1
check_root || exit 1

while true; do

    banner

    echo -e "${WHITE}Device:${RESET} $(getprop ro.product.model 2>/dev/null)"
    echo -e "${WHITE}Android:${RESET} $(getprop ro.build.version.release 2>/dev/null)"
    echo -e "${GREEN}ROOT: ACTIVE${RESET}"

    sep

    echo -e "${CYAN}1)${RESET} Install APK dari Download"
    echo -e "${CYAN}2)${RESET} Download + Install APK"
    echo -e "${CYAN}3)${RESET} Uninstall aplikasi"
    echo -e "${CYAN}4)${RESET} Cari aplikasi"
    echo -e "${CYAN}5)${RESET} Info package"
    echo -e "${CYAN}6)${RESET} System status"
    echo -e "${CYAN}7)${RESET} Bersihkan APK hasil download"
    echo -e "${CYAN}8)${RESET} Lihat log"
    echo -e "${RED}0)${RESET} Keluar"

    sep

    read -rp "> " MENU

    case "$MENU" in

        1)
            do_install_download
            pause
            ;;

        2)
            do_download_install
            pause
            ;;

        3)
            do_uninstall
            pause
            ;;

        4)
            do_search_app
            pause
            ;;

        5)
            do_app_info
            pause
            ;;

        6)
            system_status
            pause
            ;;

        7)
            clean_web_apk
            pause
            ;;

        8)
            echo
            if [ -f "$LOG_FILE" ]; then
                tail -n 100 "$LOG_FILE"
            else
                echo "Belum ada log."
            fi
            pause
            ;;

        0)
            echo
            echo -e "${CYAN}MIRZAA APK MANAGER closed.${RESET}"
            exit 0
            ;;

        *)
            error_msg "Menu tidak valid."
            sleep 1
            ;;

    esac

done
