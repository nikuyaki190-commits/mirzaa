#!/data/data/com.termux/files/usr/bin/bash
set -o pipefail

DOWNLOAD_DIR="/sdcard/Download"
WEB_DIR="$HOME/web_apk"
LOG_FILE="$HOME/install_log.txt"

mkdir -p "$WEB_DIR"

sep() {
    local width
    width=$(tput cols 2>/dev/null || echo 20)
    [ "$width" -gt 40 ] && width=40
    printf '%*s\n' "$width" '' | tr ' ' '-'
}

show_banner() {
    clear
    echo -e "\e[1;36m"
    echo "MIRZAA INSTALLER"
    sep
    echo -e "\e[0m"
}

check_root() {
    if ! su -c "echo ok" >/dev/null 2>&1; then
        echo -e "\e[1;31mAkses root tidak tersedia / ditolak.\e[0m"
        exit 1
    fi
}

get_size_mb() {
    local file="$1"
    if [ -f "$file" ]; then
        local bytes
        bytes=$(stat -c%s "$file" 2>/dev/null || echo 0)
        awk -v b="$bytes" 'BEGIN { printf "%.1fMB", b/1024/1024 }'
    else
        echo "0MB"
    fi
}

parse_selection() {
    local choice="$1"
    local max="$2"
    local -n result=$3
    result=()

    choice=$(echo "$choice" | tr -d '[:space:]')
    [ -z "$choice" ] && return

    if [ "$choice" == "all" ]; then
        for ((i=0; i<max; i++)); do result+=($i); done
        return
    fi

    if [[ "$choice" =~ ^[0-9]+-[0-9]+$ ]]; then
        local start=$(echo "$choice" | cut -d'-' -f1)
        local end=$(echo "$choice" | cut -d'-' -f2)
        if [ "$start" -gt "$end" ]; then
            local tmp=$start; start=$end; end=$tmp
        fi
        for ((i=start; i<=end; i++)); do
            idx=$((i-1))
            [ $idx -ge 0 ] && [ $idx -lt $max ] && result+=($idx)
        done
        return
    fi

    if [[ "$choice" =~ ^[0-9,]+$ ]]; then
        IFS=',' read -ra nums <<< "$choice"
        for n in "${nums[@]}"; do
            [ -z "$n" ] && continue
            idx=$((n-1))
            [ $idx -ge 0 ] && [ $idx -lt $max ] && result+=($idx)
        done
        return
    fi

    echo -e "\e[1;31mFormat tidak dikenali: '$choice'\e[0m"
}

install_selected() {
    local -n list=$1
    local -n indices=$2
    local delete_after=$3

    if [ ${#indices[@]} -eq 0 ]; then
        echo "Tidak ada APK dipilih."
        return
    fi

    echo ""
    echo "=== Install - $(date +%H:%M:%S) ===" | tee -a "$LOG_FILE"

    local ok=0 fail=0

    for idx in "${indices[@]}"; do
        apk="${list[$idx]}"

        if [ ! -f "$apk" ]; then
            echo -e "\e[1;31mX File hilang: $(basename "$apk")\e[0m" | tee -a "$LOG_FILE"
            fail=$((fail+1))
            continue
        fi

        NAME=$(basename "$apk")
        echo -e "\e[1;33m> $NAME\e[0m" | tee -a "$LOG_FILE"

        RESULT=$(su -c "pm install -r '$apk'" 2>&1)
        echo "$RESULT" | tee -a "$LOG_FILE"

        if echo "$RESULT" | grep -qi "Success"; then
            echo -e "\e[1;32mOK: $NAME\e[0m" | tee -a "$LOG_FILE"
            ok=$((ok+1))
            if [ "$delete_after" == "yes" ]; then
                rm -f "$apk"
                echo -e "\e[1;34mHapus sumber: $NAME\e[0m" | tee -a "$LOG_FILE"
            fi
        else
            echo -e "\e[1;31mGAGAL: $NAME\e[0m" | tee -a "$LOG_FILE"
            fail=$((fail+1))
        fi
        sep
    done

    echo ""
    echo -e "OK:\e[1;32m$ok\e[0m FAIL:\e[1;31m$fail\e[0m"
    echo "Log: $LOG_FILE"
}

do_install() {
    if [ ! -d "$DOWNLOAD_DIR" ]; then
        echo "Folder Download tidak ada. Jalankan 'termux-setup-storage'."
        return
    fi

    mapfile -t APK_LIST < <(find "$DOWNLOAD_DIR" -maxdepth 1 -iname "*.apk" 2>/dev/null | sort)

    if [ ${#APK_LIST[@]} -eq 0 ]; then
        echo "Tidak ada APK di $DOWNLOAD_DIR"
        return
    fi

    echo "APK ditemukan:"
    for i in "${!APK_LIST[@]}"; do
        SIZE=$(get_size_mb "${APK_LIST[$i]}")
        echo "$((i+1)). $(basename "${APK_LIST[$i]}") ($SIZE)"
    done
    sep
    echo "Pilih (1-${#APK_LIST[@]} / range / all):"
    read -p "> " CHOICE

    local indices
    parse_selection "$CHOICE" "${#APK_LIST[@]}" indices

    install_selected APK_LIST indices "yes"
}

do_download_install() {
    echo "a) Link langsung  b) Scan halaman"
    read -p "> " METHOD

    LINKS=""

    if [ "$METHOD" == "b" ]; then
        read -p "URL halaman: " PAGE_URL

        if [[ ! "$PAGE_URL" =~ ^https?:// ]]; then
            echo "URL tidak valid."
            return
        fi

        echo "Mengambil daftar file..."
        HTML=$(curl -sL --max-time 20 "$PAGE_URL")

        if [ -z "$HTML" ]; then
            echo "Gagal ambil halaman."
            return
        fi

        mapfile -t FOUND_LINKS < <(echo "$HTML" | grep -oE '(href|src)="[^"]+\.apk"' | sed -E 's/(href|src)="//;s/"$//' | sort -u)

        if [ ${#FOUND_LINKS[@]} -eq 0 ]; then
            echo "Tidak ada .apk ditemukan."
            return
        fi

        local base
        base=$(echo "$PAGE_URL" | grep -oE '^https?://[^/]+')

        for i in "${!FOUND_LINKS[@]}"; do
            link="${FOUND_LINKS[$i]}"
            if [[ "$link" != http* ]]; then
                if [[ "$link" == /* ]]; then
                    FOUND_LINKS[$i]="${base}${link}"
                else
                    FOUND_LINKS[$i]="${PAGE_URL%/}/${link}"
                fi
            fi
        done

        echo "Ditemukan:"
        for i in "${!FOUND_LINKS[@]}"; do
            echo "$((i+1)). $(basename "${FOUND_LINKS[$i]}")"
        done
        sep
        echo "Pilih (1-${#FOUND_LINKS[@]} / range / all):"
        read -p "> " CHOICE

        local indices
        parse_selection "$CHOICE" "${#FOUND_LINKS[@]}" indices
        if [ ${#indices[@]} -eq 0 ]; then
            echo "Tidak ada dipilih."
            return
        fi

        for idx in "${indices[@]}"; do
            LINKS="$LINKS ${FOUND_LINKS[$idx]}"
        done
    else
        echo "Paste link (pisah spasi):"
        read -p "> " LINKS
    fi

    LINKS=$(echo "$LINKS" | tr -d '\r')
    if [ -z "$(echo "$LINKS" | tr -d '[:space:]')" ]; then
        echo "Tidak ada link."
        return
    fi

    echo "Mengunduh..."
    WEB_APK_LIST=()
    local i=1
    for url in $LINKS; do
        [[ "$url" =~ ^https?:// ]] || { echo "X invalid: $url"; continue; }

        fname="dl_$(date +%s)_${i}.apk"
        echo "> $url"

        HTTP_CODE=$(curl -L -o "$WEB_DIR/$fname" -w "%{http_code}" --max-time 60 --silent "$url")

        if [ -s "$WEB_DIR/$fname" ] && [ "$HTTP_CODE" == "200" ]; then
            SIZE=$(get_size_mb "$WEB_DIR/$fname")
            echo "OK: $fname ($SIZE)"
            WEB_APK_LIST+=("$WEB_DIR/$fname")
        else
            echo "GAGAL (HTTP $HTTP_CODE): $url"
            rm -f "$WEB_DIR/$fname"
        fi
        i=$((i+1))
    done

    if [ ${#WEB_APK_LIST[@]} -eq 0 ]; then
        echo "Tidak ada berhasil diunduh."
        return
    fi

    echo "Terunduh:"
    for i in "${!WEB_APK_LIST[@]}"; do
        SIZE=$(get_size_mb "${WEB_APK_LIST[$i]}")
        echo "$((i+1)). $(basename "${WEB_APK_LIST[$i]}") ($SIZE)"
    done
    sep
    echo "Install yang mana? (1-${#WEB_APK_LIST[@]} / all):"
    read -p "> " CHOICE2

    local indices2
    parse_selection "$CHOICE2" "${#WEB_APK_LIST[@]}" indices2

    install_selected WEB_APK_LIST indices2 "yes"
}

do_uninstall() {
    echo "Mengambil daftar aplikasi..."
    mapfile -t PKG_LIST < <(su -c "pm list packages -3" 2>/dev/null | sed 's/^package://' | sort)

    if [ ${#PKG_LIST[@]} -eq 0 ]; then
        echo "Tidak ada aplikasi ditemukan."
        return
    fi

    echo "Terpasang:"
    for i in "${!PKG_LIST[@]}"; do
        echo "$((i+1)). ${PKG_LIST[$i]}"
    done
    sep
    echo "Pilih (1-${#PKG_LIST[@]} / range / all):"
    read -p "> " CHOICE

    local indices
    parse_selection "$CHOICE" "${#PKG_LIST[@]}" indices
    if [ ${#indices[@]} -eq 0 ]; then
        echo "Tidak ada dipilih."
        return
    fi

    echo ""
    echo "=== Uninstall - $(date +%H:%M:%S) ===" | tee -a "$LOG_FILE"

    local ok=0 fail=0
    for idx in "${indices[@]}"; do
        pkg="${PKG_LIST[$idx]}"
        echo -e "\e[1;33m> $pkg\e[0m" | tee -a "$LOG_FILE"

        RESULT=$(su -c "pm uninstall --user 0 '$pkg'" 2>&1)
        echo "$RESULT" | tee -a "$LOG_FILE"

        if echo "$RESULT" | grep -qi "Success"; then
            echo -e "\e[1;32mOK: $pkg\e[0m" | tee -a "$LOG_FILE"
            ok=$((ok+1))
        else
            echo -e "\e[1;31mGAGAL: $pkg\e[0m" | tee -a "$LOG_FILE"
            fail=$((fail+1))
        fi
        sep
    done

    echo ""
    echo -e "OK:\e[1;32m$ok\e[0m FAIL:\e[1;31m$fail\e[0m"
    echo "Log: $LOG_FILE"
}

check_root

while true; do
    show_banner
    echo "1) Install dari Download"
    echo "2) Download+Install dari link"
    echo "3) Uninstall app"
    echo "0) Keluar"
    read -p "> " MENU

    case "$MENU" in
        1) do_install ;;
        2) do_download_install ;;
        3) do_uninstall ;;
        0) echo "Bye!"; exit 0 ;;
        *) echo "Tidak valid." ;;
    esac

    echo ""
    read -p "[ENTER untuk kembali]" _
done
