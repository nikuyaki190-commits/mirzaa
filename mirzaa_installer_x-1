#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================
# MIRZAA APK MANAGER X
# Modern Root APK / Package Manager for Termux
# ==============================================================

set -o pipefail
shopt -s nullglob

APP_NAME="MIRZAA APK MANAGER"
VERSION="X1.0"

DOWNLOAD_DIR="/sdcard/Download"
ROOT_DIR="$HOME/mirzaa"
WEB_DIR="$ROOT_DIR/downloads"
BACKUP_DIR="$ROOT_DIR/backups"
LOG_FILE="$ROOT_DIR/mirzaa.log"
CONFIG_FILE="$ROOT_DIR/config"

mkdir -p "$WEB_DIR" "$BACKUP_DIR"
touch "$LOG_FILE"

# ---------------- COLORS ----------------
R='\e[0m'; B='\e[1m'
RED='\e[1;31m'; GRN='\e[1;32m'; YEL='\e[1;33m'
BLU='\e[1;34m'; CYN='\e[1;36m'; MAG='\e[1;35m'
WHT='\e[1;37m'; DIM='\e[2m'

# ---------------- SETTINGS ----------------
DELETE_AFTER_INSTALL="no"
DOWNLOAD_TIMEOUT=180

[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE" 2>/dev/null || true

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

ok()   { echo -e "${GRN}✓${R} $*"; log "OK: $*"; }
err()  { echo -e "${RED}✗${R} $*"; log "ERROR: $*"; }
warn() { echo -e "${YEL}!${R} $*"; }
info() { echo -e "${CYN}›${R} $*"; }

pause() {
    echo
    read -rp "ENTER untuk kembali..." _
}

term_width() {
    local w
    w=$(tput cols 2>/dev/null || echo 50)
    (( w < 42 )) && w=42
    (( w > 72 )) && w=72
    echo "$w"
}

line() {
    printf '%*s\n' "$(term_width)" '' | tr ' ' '─'
}

clear_screen() {
    printf '\033c'
}

header() {
    clear_screen
    echo -e "${CYN}${B}"
    echo "╭────────────────────────────────────────────────────────────╮"
    printf "│ %-58s │\n" "$APP_NAME"
    printf "│ %-58s │\n" "Root Edition • $VERSION"
    echo "╰────────────────────────────────────────────────────────────╯"
    echo -e "${R}"
}

human_size() {
    local f="$1" n
    [ -f "$f" ] || { echo "0 B"; return; }
    n=$(stat -c%s "$f" 2>/dev/null || echo 0)
    awk -v n="$n" 'BEGIN {
        if(n>=1073741824) printf "%.2f GB",n/1073741824;
        else if(n>=1048576) printf "%.2f MB",n/1048576;
        else if(n>=1024) printf "%.2f KB",n/1024;
        else printf "%d B",n
    }'
}

root_cmd() {
    su -c "$*" 2>/dev/null
}

root_available() {
    command -v su >/dev/null 2>&1 || return 1
    su -c 'id -u' 2>/dev/null | grep -qx '0'
}

check_deps() {
    local missing=()
    for c in curl find grep sed awk sort stat basename head tail date df pm; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done

    if ((${#missing[@]})); then
        err "Dependency hilang: ${missing[*]}"
        echo "Coba:"
        echo "pkg update && pkg install curl coreutils findutils grep sed gawk"
        return 1
    fi
}

storage_ready() {
    [ -d "$DOWNLOAD_DIR" ] || {
        warn "Storage Termux belum aktif."
        echo "Jalankan: termux-setup-storage"
        return 1
    }
}

# ---------------- APK HELPERS ----------------

apk_package() {
    local apk="$1" out
    if command -v aapt >/dev/null 2>&1; then
        out=$(aapt dump badging "$apk" 2>/dev/null |
              sed -n "s/^package: name='\([^']*\)'.*/\1/p" | head -n1)
        [ -n "$out" ] && { echo "$out"; return; }
    fi
    echo "-"
}

apk_version() {
    local apk="$1" out
    if command -v aapt >/dev/null 2>&1; then
        out=$(aapt dump badging "$apk" 2>/dev/null |
              sed -n "s/^package:.*versionName='\([^']*\)'.*/\1/p" | head -n1)
        [ -n "$out" ] && { echo "$out"; return; }
    fi
    echo "-"
}

apk_valid() {
    local f="$1"
    [ -s "$f" ] || return 1

    # APK ZIP signature: PK\x03\x04
    local magic
    magic=$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')
    [[ "$magic" == "504b0304" || "$magic" == "504b0506" || "$magic" == "504b0708" ]]
}

list_download_apks() {
    mapfile -t APK_FILES < <(
        find "$DOWNLOAD_DIR" -maxdepth 1 -type f -iname '*.apk' 2>/dev/null | sort
    )
}

parse_selection() {
    local input="$1" max="$2"
    local -n out="$3"
    out=()
    input=$(echo "$input" | tr -d '[:space:]')
    [ -z "$input" ] && return

    if [ "$input" = "all" ]; then
        for ((i=0;i<max;i++)); do out+=("$i"); done
        return
    fi

    if [[ "$input" =~ ^[0-9]+-[0-9]+$ ]]; then
        local a="${input%-*}" b="${input#*-}" t
        ((a>b)) && { t=$a; a=$b; b=$t; }
        for ((i=a;i<=b;i++)); do
            ((i>=1 && i<=max)) && out+=("$((i-1))")
        done
        return
    fi

    if [[ "$input" =~ ^[0-9,]+$ ]]; then
        IFS=',' read -ra nums <<< "$input"
        for n in "${nums[@]}"; do
            [[ "$n" =~ ^[0-9]+$ ]] || continue
            ((n>=1 && n<=max)) && out+=("$((n-1))")
        done
        return
    fi

    err "Format tidak valid."
}

confirm() {
    local q="$1" a
    read -rp "$q [y/N]: " a
    [[ "$a" =~ ^[Yy]$ ]]
}

# ---------------- INSTALL ENGINE ----------------

install_apk() {
    local apk="$1"

    [ -f "$apk" ] || { err "File tidak ada: $apk"; return 1; }
    apk_valid "$apk" || { err "File bukan APK valid: $(basename "$apk")"; return 1; }

    local name pkg result
    name=$(basename "$apk")
    pkg=$(apk_package "$apk")

    echo
    echo -e "${YEL}INSTALL${R} $name"
    echo -e "${DIM}Size: $(human_size "$apk") | Package: $pkg${R}"

    result=$(su -c "pm install -r --user 0 '$apk'" 2>&1)
    echo "$result"

    if echo "$result" | grep -qi 'success'; then
        ok "Installed: $name"
        log "INSTALL package=$pkg file=$name"

        if [ "$DELETE_AFTER_INSTALL" = "yes" ]; then
            rm -f "$apk"
            info "Source APK deleted."
        fi
        return 0
    fi

    err "Install gagal: $name"
    log "INSTALL_FAIL package=$pkg result=$result"
    return 1
}

install_from_download() {
    storage_ready || return

    while :; do
        list_download_apks
        header
        echo -e "${WHT}LOCAL APK${R}  ${DIM}$DOWNLOAD_DIR${R}"
        line

        ((${#APK_FILES[@]})) || {
            warn "Tidak ada APK."
            pause
            return
        }

        for i in "${!APK_FILES[@]}"; do
            f="${APK_FILES[$i]}"
            echo -e "${CYN}$((i+1))${R}  $(basename "$f")"
            echo -e "    ${DIM}$(human_size "$f") • $(apk_package "$f") • v$(apk_version "$f")${R}"
        done

        line
        echo "Pilih: 1 | 1,3 | 1-5 | all"
        echo "r = refresh | q = back"
        read -rp "> " c

        case "$c" in q|Q) return;; r|R) continue;; esac

        local idx okc=0 failc=0
        parse_selection "$c" "${#APK_FILES[@]}" idx
        ((${#idx[@]})) || continue

        for n in "${idx[@]}"; do
            if install_apk "${APK_FILES[$n]}"; then ((okc++)); else ((failc++)); fi
            line
        done

        echo -e "${GRN}SUCCESS $okc${R}  ${RED}FAILED $failc${R}"
        pause
    done
}

# ---------------- DOWNLOAD ENGINE ----------------

download_one() {
    local url="$1" out="$2"

    curl -L --fail --show-error --progress-bar \
        --connect-timeout 15 --max-time "$DOWNLOAD_TIMEOUT" \
        -o "$out" "$url" || {
            rm -f "$out"
            return 1
        }

    apk_valid "$out" || {
        rm -f "$out"
        return 1
    }
}

download_install() {
    local url out base
    echo
    read -rp "APK URL: " url
    [[ "$url" =~ ^https?:// ]] || { err "URL invalid."; return; }

    base=$(basename "${url%%\?*}")
    [[ "$base" == *.apk ]] || base="download_$(date +%s).apk"
    out="$WEB_DIR/$base"

    # Avoid overwriting existing file.
    [ -e "$out" ] && out="$WEB_DIR/$(date +%s)_$base"

    echo
    info "Downloading..."
    if download_one "$url" "$out"; then
        ok "Downloaded: $(basename "$out") ($(human_size "$out"))"
        echo
        if confirm "Install sekarang?"; then
            install_apk "$out"
        else
            info "Disimpan di $out"
        fi
    else
        err "Download gagal atau response bukan APK."
    fi
}

download_batch() {
    local links lineurl count=0
    echo "Masukkan URL APK, satu per baris."
    echo "Ketik END untuk selesai."
    echo
    while IFS= read -r lineurl; do
        [ "$lineurl" = "END" ] && break
        [ -z "$lineurl" ] && continue
        [[ "$lineurl" =~ ^https?:// ]] || { warn "Skip: $lineurl"; continue; }

        local base out
        base=$(basename "${lineurl%%\?*}")
        [[ "$base" == *.apk ]] || base="download_$(date +%s)_$count.apk"
        out="$WEB_DIR/$base"
        [ -e "$out" ] && out="$WEB_DIR/$(date +%s)_$base"

        echo
        if download_one "$lineurl" "$out"; then
            ok "$(basename "$out")"
            ((count++))
        else
            err "Gagal: $lineurl"
        fi
    done

    echo
    echo "Berhasil: $count"
}

# ---------------- PACKAGE ENGINE ----------------

get_user_packages() {
    mapfile -t PKGS < <(
        su -c 'pm list packages -3' 2>/dev/null |
        sed 's/^package://' | sort
    )
}

package_info() {
    local pkg="$1"
    [ -n "$pkg" ] || read -rp "Package: " pkg
    [ -n "$pkg" ] || return

    header
    echo -e "${WHT}PACKAGE INFO${R}"
    line

    su -c "dumpsys package '$pkg'" 2>/dev/null |
        grep -E 'versionName=|versionCode=|firstInstallTime=|lastUpdateTime=|codePath=|dataDir=' |
        head -n 25

    echo
    echo "APK:"
    su -c "pm path '$pkg'" 2>/dev/null
    pause
}

search_packages() {
    local q
    read -rp "Search package: " q
    [ -n "$q" ] || return

    get_user_packages
    echo
    line

    local n=0
    for pkg in "${PKGS[@]}"; do
        if echo "$pkg" | grep -qi -- "$q"; then
            echo "$pkg"
            ((n++))
        fi
    done

    echo
    echo "Found: $n"
    pause
}

uninstall_packages() {
    get_user_packages
    ((${#PKGS[@]})) || { warn "Tidak ada user app."; pause; return; }

    header
    echo -e "${WHT}PACKAGE MANAGER / UNINSTALL${R}"
    line

    for i in "${!PKGS[@]}"; do
        echo -e "${CYN}$((i+1))${R}  ${PKGS[$i]}"
    done

    line
    read -rp "Pilih: " c

    local idx
    parse_selection "$c" "${#PKGS[@]}" idx
    ((${#idx[@]})) || return

    echo
    for n in "${idx[@]}"; do echo "• ${PKGS[$n]}"; done
    echo

    confirm "Uninstall package terpilih?" || { info "Cancelled."; pause; return; }

    for n in "${idx[@]}"; do
        local pkg="${PKGS[$n]}" result
        su -c "am force-stop '$pkg'" >/dev/null 2>&1
        result=$(su -c "pm uninstall --user 0 '$pkg'" 2>&1)
        if echo "$result" | grep -qi success; then
            ok "$pkg removed"
            log "UNINSTALL $pkg"
        else
            err "$pkg: $result"
        fi
    done
    pause
}

disable_enable_package() {
    local action pkg result
    echo "1) Disable"
    echo "2) Enable"
    read -rp "> " action
    read -rp "Package: " pkg
    [ -n "$pkg" ] || return

    case "$action" in
        1) result=$(su -c "pm disable-user --user 0 '$pkg'" 2>&1);;
        2) result=$(su -c "pm enable '$pkg'" 2>&1);;
        *) return;;
    esac

    echo "$result"
    echo "$result" | grep -qi 'enabled\|disabled' && ok "Done."
    pause
}

# ---------------- BACKUP ----------------

backup_apk() {
    local pkg path out name
    read -rp "Package yang mau dibackup: " pkg
    [ -n "$pkg" ] || return

    mapfile -t paths < <(su -c "pm path '$pkg'" 2>/dev/null | sed 's/^package://')

    ((${#paths[@]})) || { err "Package tidak ditemukan."; pause; return; }

    mkdir -p "$BACKUP_DIR/$pkg"
    local count=0

    for path in "${paths[@]}"; do
        name=$(basename "$path")
        out="$BACKUP_DIR/$pkg/$name"
        if su -c "cp '$path' '$out'" >/dev/null 2>&1; then
            ok "Backed up $name"
            ((count++))
        else
            err "Gagal backup $name"
        fi
    done

    echo
    echo "Backup: $BACKUP_DIR/$pkg"
    echo "Files: $count"
    pause
}

# ---------------- SYSTEM ----------------

system_dashboard() {
    header

    local model android sdk root storage ram
    model=$(getprop ro.product.model 2>/dev/null)
    android=$(getprop ro.build.version.release 2>/dev/null)
    sdk=$(getprop ro.build.version.sdk 2>/dev/null)
    root=$(su -c 'id -u' 2>/dev/null || echo no)
    storage=$(df -h /sdcard 2>/dev/null | tail -n1 | awk '{print $4}')
    ram=$(awk '/MemAvailable/ {printf "%.0f MB", $2/1024}' /proc/meminfo 2>/dev/null)

    echo -e "${WHT}SYSTEM${R}"
    line
    printf "Device       : %s\n" "$model"
    printf "Android      : %s (SDK %s)\n" "$android" "$sdk"
    printf "Root         : %s\n" "$root"
    printf "RAM Available: %s\n" "${ram:-unknown}"
    printf "Storage Free : %s\n" "${storage:-unknown}"
    printf "Download Dir : %s\n" "$DOWNLOAD_DIR"
    printf "Backup Dir   : %s\n" "$BACKUP_DIR"
    printf "Log          : %s\n" "$LOG_FILE"

    echo
    echo -e "${WHT}PACKAGE COUNT${R}"
    line
    get_user_packages
    echo "User apps: ${#PKGS[@]}"

    pause
}

settings_menu() {
    while :; do
        header
        echo -e "${WHT}SETTINGS${R}"
        line
        echo "1) Delete APK after successful install : $DELETE_AFTER_INSTALL"
        echo "2) Download timeout                    : ${DOWNLOAD_TIMEOUT}s"
        echo "3) Clear download cache"
        echo "0) Back"
        line
        read -rp "> " c

        case "$c" in
            1)
                if [ "$DELETE_AFTER_INSTALL" = "yes" ]; then
                    DELETE_AFTER_INSTALL="no"
                else
                    DELETE_AFTER_INSTALL="yes"
                fi
                ;;
            2)
                read -rp "Timeout seconds: " t
                [[ "$t" =~ ^[0-9]+$ ]] && DOWNLOAD_TIMEOUT="$t"
                ;;
            3)
                if confirm "Hapus semua APK di $WEB_DIR?"; then
                    rm -f "$WEB_DIR"/*.apk
                    ok "Cache cleared."
                    pause
                fi
                ;;
            0) return;;
        esac

        cat > "$CONFIG_FILE" <<EOF
DELETE_AFTER_INSTALL="$DELETE_AFTER_INSTALL"
DOWNLOAD_TIMEOUT="$DOWNLOAD_TIMEOUT"
EOF
    done
}

logs_menu() {
    header
    echo -e "${WHT}ACTIVITY LOG${R}"
    line
    [ -s "$LOG_FILE" ] && tail -n 120 "$LOG_FILE" || echo "Belum ada log."
    pause
}

# ---------------- MAIN ----------------

check_deps || exit 1
root_available || {
    err "Root tidak tersedia / Magisk belum memberi izin."
    exit 1
}

while :; do
    header

    model=$(getprop ro.product.model 2>/dev/null)
    android=$(getprop ro.build.version.release 2>/dev/null)

    echo -e "${DIM}$model • Android $android • ${GRN}ROOT ONLINE${R}"
    line

    echo -e "${CYN}01${R}  Install APK"
    echo -e "${CYN}02${R}  Download + Install"
    echo -e "${CYN}03${R}  Batch Download"
    echo -e "${CYN}04${R}  Uninstall Apps"
    echo -e "${CYN}05${R}  Search Package"
    echo -e "${CYN}06${R}  Package Info"
    echo -e "${CYN}07${R}  Enable / Disable"
    echo -e "${CYN}08${R}  Backup APK"
    echo -e "${CYN}09${R}  System Dashboard"
    echo -e "${CYN}10${R} Settings"
    echo -e "${CYN}11${R} Activity Log"
    echo -e "${RED}00${R} Exit"

    line
    read -rp "MIRZAA › " menu

    case "$menu" in
        1|01) install_from_download ;;
        2|02) download_install; pause ;;
        3|03) download_batch; pause ;;
        4|04) uninstall_packages ;;
        5|05) search_packages ;;
        6|06) package_info ;;
        7|07) disable_enable_package ;;
        8|08) backup_apk ;;
        9|09) system_dashboard ;;
        10) settings_menu ;;
        11) logs_menu ;;
        0|00)
            echo -e "${CYN}MIRZAA closed.${R}"
            exit 0
            ;;
        *)
            err "Menu tidak tersedia."
            sleep 1
            ;;
    esac
done
